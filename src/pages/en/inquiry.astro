---
import Layout from '../../layouts/Layout.astro';
import { siteEn } from '../../data/site.en';
import { uiEn } from '../../data/ui.en';

const ui = uiEn;

const FORMSPREE_ENDPOINT = 'https://formspree.io/f/mkodegwe';
const successMessage = ui.inquiryForm.successMessage;
const errorMessage = ui.inquiryForm.errorMessage;
---

<Layout
  locale="en"
  title={`${ui.inquiryForm.pageTitle} — ${siteEn.meta.title}`}
  description={siteEn.meta.description}
  ui={ui}
>
  <section class="hero">
    <div class="container">
      <h1>{ui.inquiryForm.pageTitle}</h1>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p>{ui.inquiryForm.intro}</p>
      <form action={FORMSPREE_ENDPOINT} method="POST" class="inquiry-form">
        <label class="form-field">
          <span>{ui.inquiryForm.name}</span>
          <input type="text" name="name" required />
        </label>
        <label class="form-field">
          <span>{ui.inquiryForm.email}</span>
          <input type="email" name="email" required />
        </label>
        <label class="form-field">
          <span>{ui.inquiryForm.message}</span>
          <textarea name="message" rows="6" required></textarea>
        </label>
        <button type="submit" class="btn btn--primary">{ui.inquiryForm.submit}</button>
      </form>
      <p class="form-status" data-form-status hidden></p>
    </div>
  </section>
</Layout>

<script is:inline define:vars={{ successMessage, errorMessage }}>
  function initForm() {
    const form = document.querySelector('.inquiry-form');
    const status = document.querySelector('[data-form-status]');
    if (!form || !status || form.dataset.initialized) return;
    form.dataset.initialized = 'true';

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submitBtn = form.querySelector('button[type="submit"]');
      if (submitBtn) submitBtn.disabled = true;
      status.hidden = true;
      status.className = 'form-status';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (response.ok) {
          form.hidden = true;
          status.textContent = successMessage;
          status.classList.add('form-status--success');
          status.hidden = false;
        } else {
          status.textContent = errorMessage;
          status.classList.add('form-status--error');
          status.hidden = false;
          if (submitBtn) submitBtn.disabled = false;
        }
      } catch {
        status.textContent = errorMessage;
        status.classList.add('form-status--error');
        status.hidden = false;
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initForm);
  document.addEventListener('astro:page-load', initForm);
</script>
