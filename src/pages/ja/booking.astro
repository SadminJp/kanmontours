---
import Layout from '../../layouts/Layout.astro';
import BookingCalendar from '../../components/BookingCalendar.astro';
import { siteJa } from '../../data/site.ja';
import { toursJa } from '../../data/tours.ja';
import { uiJa } from '../../data/ui.ja';
import { MIN_LEAD_DAYS, tourSchedules } from '../../data/schedules';

const ui = uiJa;
const tours = toursJa;

const FORMSPREE_ENDPOINT = 'https://formspree.io/f/mpqvnwab';
const successMessage = ui.booking.successMessage;
const errorMessage = ui.booking.errorMessage;
---

<Layout
  locale="ja"
  title={`${ui.booking.pageTitle} — ${siteJa.meta.title}`}
  description={siteJa.meta.description}
  ui={ui}
>
  <section class="hero">
    <div class="container">
      <h1>{ui.booking.pageTitle}</h1>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <form action={FORMSPREE_ENDPOINT} method="POST" class="booking-form">
        <h2>{ui.booking.step1}</h2>
        <div class="tour-options">
          {tours.map((tour) => (
            <label class="tour-option">
              <input
                type="checkbox"
                name="tours"
                data-tour-slug={tour.slug}
                value={`${tour.number} ${tour.title} (${tour.bookingPrice})`}
              />
              <span>{tour.number} &mdash; {tour.title} &mdash; {ui.booking.perPerson} {tour.bookingPrice}</span>
            </label>
          ))}
        </div>

        <h2>{ui.booking.step2}</h2>
        <p>{ui.booking.calendarHint}</p>
        <BookingCalendar
          ui={ui}
          inputName="preferred-date"
          schedules={tourSchedules}
          minLeadDays={MIN_LEAD_DAYS}
        />

        <h2>{ui.booking.step3}</h2>
        <div class="form-row">
          <label class="form-field">
            <span>{ui.booking.fields.adults}</span>
            <input type="number" name="adults" min="0" required />
          </label>
          <label class="form-field">
            <span>{ui.booking.fields.underAge}</span>
            <input type="number" name="minors" min="0" />
          </label>
        </div>

        <h3>{ui.booking.fields.representativeName}</h3>
        <div class="form-row">
          <label class="form-field">
            <span>{ui.booking.fields.kanji}</span>
            <input type="text" name="representative-kanji" required />
          </label>
          <label class="form-field">
            <span>{ui.booking.fields.katakana}</span>
            <input type="text" name="representative-katakana" required />
          </label>
        </div>

        <h3>{ui.booking.fields.contact}</h3>
        <div class="form-row">
          <label class="form-field">
            <span>{ui.booking.fields.email}</span>
            <input type="email" name="email" required />
          </label>
          <label class="form-field">
            <span>{ui.booking.fields.phone}</span>
            <input type="tel" name="phone" required />
          </label>
        </div>

        <h2>{ui.booking.step4}</h2>
        <label class="form-checkbox">
          <input type="checkbox" name="terms-agreed" required />
          <span>
            {ui.booking.termsAgree}
            {' '}
            <a href="../policies/">{ui.nav.policies}</a>
          </span>
        </label>

        <button type="submit" class="btn btn--primary">{ui.booking.submit}</button>
      </form>
      <p class="form-status" data-form-status hidden></p>
    </div>
  </section>
</Layout>

<script is:inline define:vars={{ successMessage, errorMessage }}>
  function initForm() {
    const form = document.querySelector('.booking-form');
    const status = document.querySelector('[data-form-status]');
    if (!form || !status || form.dataset.initialized) return;
    form.dataset.initialized = 'true';

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submitBtn = form.querySelector('button[type="submit"]');
      if (submitBtn) submitBtn.disabled = true;
      status.hidden = true;
      status.className = 'form-status';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (response.ok) {
          form.hidden = true;
          status.textContent = successMessage;
          status.classList.add('form-status--success');
          status.hidden = false;
        } else {
          status.textContent = errorMessage;
          status.classList.add('form-status--error');
          status.hidden = false;
          if (submitBtn) submitBtn.disabled = false;
        }
      } catch {
        status.textContent = errorMessage;
        status.classList.add('form-status--error');
        status.hidden = false;
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initForm);
  document.addEventListener('astro:page-load', initForm);
</script>
