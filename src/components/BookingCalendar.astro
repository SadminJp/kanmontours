---
import type { UiStrings } from '../data/types';

interface Props {
  ui: UiStrings;
  inputName?: string;
}

const { ui, inputName = 'preferred-date' } = Astro.props;
---

<div
  class="booking-calendar"
  data-months={JSON.stringify(ui.calendar.months)}
  data-weekdays={JSON.stringify(ui.calendar.weekdays)}
  data-selected-label={ui.booking.selectedDate}
>
  <p class="booking-calendar__status">Loading available dates…</p>
  <div class="booking-calendar__header" hidden>
    <button type="button" class="booking-calendar__nav" data-action="prev" aria-label="Previous month">&#9664;</button>
    <span class="booking-calendar__title"></span>
    <button type="button" class="booking-calendar__nav" data-action="next" aria-label="Next month">&#9654;</button>
  </div>
  <div class="booking-calendar__weekdays"></div>
  <div class="booking-calendar__grid"></div>
  <p class="booking-calendar__selected"></p>
  <input type="hidden" name={inputName} class="booking-calendar__input" required />
</div>

<style is:global>
  /* Global: the day grid is rebuilt client-side via innerHTML, so Astro's
     scoped-style attribute never reaches those cells — this must stay global. */
  .booking-calendar {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1rem;
    max-width: 420px;
  }

  .booking-calendar__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .booking-calendar__title {
    font-weight: 700;
    color: var(--color-navy);
  }

  .booking-calendar__nav {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    width: 2rem;
    height: 2rem;
    cursor: pointer;
    color: var(--color-blue-dark);
  }

  .booking-calendar__nav:hover {
    background: var(--color-blue);
    color: #ffffff;
  }

  .booking-calendar__weekdays,
  .booking-calendar__grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.25rem;
    text-align: center;
  }

  .booking-calendar__weekdays div {
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    padding: 0.25rem 0;
  }

  .booking-calendar__day {
    padding: 0.5rem 0;
    border-radius: var(--radius);
    cursor: pointer;
    font-size: 0.9rem;
  }

  .booking-calendar__day:hover {
    background: var(--color-bg-alt);
  }

  .booking-calendar__day.is-empty {
    cursor: default;
  }

  /* Before the booking cut-off, or not an operating day for the chosen tours. */
  .booking-calendar__day.is-past,
  .booking-calendar__day.is-unavailable {
    color: var(--color-border);
    cursor: not-allowed;
  }

  .booking-calendar__day.is-past:hover,
  .booking-calendar__day.is-unavailable:hover {
    background: transparent;
  }

  .booking-calendar__day.is-selected {
    background: var(--color-orange);
    color: #ffffff;
    font-weight: 700;
  }

  .booking-calendar__selected {
    margin: 0.75rem 0 0;
    font-weight: 600;
    color: var(--color-navy);
    min-height: 1.5em;
  }

  .booking-calendar__status {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .booking-calendar__status.is-error {
    color: var(--color-orange-dark);
    font-weight: 600;
  }
</style>

<script>
  interface TourSchedule {
    weekdays: number[];
    blackoutDates: string[];
    extraDates: string[];
  }

  interface SchedulesResponse {
    minLeadDays: number;
    tours: Record<string, TourSchedule>;
  }

  const SCHEDULES_URL = '/api/schedules';

  async function initCalendars() {
    const calendars = Array.from(document.querySelectorAll<HTMLElement>('.booking-calendar')).filter(
      (calendar) => !calendar.dataset.initialized
    );
    if (!calendars.length) return;
    calendars.forEach((calendar) => (calendar.dataset.initialized = 'true'));

    // One fetch shared by every calendar on the page — in practice there's
    // only ever one, but this avoids a redundant request if that changes.
    let schedulesData: SchedulesResponse;
    try {
      const response = await fetch(SCHEDULES_URL);
      if (!response.ok) throw new Error(`Request failed: ${response.status}`);
      schedulesData = await response.json();
    } catch {
      calendars.forEach((calendar) => {
        const statusEl = calendar.querySelector<HTMLElement>('.booking-calendar__status')!;
        statusEl.textContent = 'Unable to load available dates. Please contact us to book.';
        statusEl.classList.add('is-error');
      });
      return;
    }

    calendars.forEach((calendar) => initCalendar(calendar, schedulesData));
  }

  function initCalendar(calendar: HTMLElement, schedulesData: SchedulesResponse) {
    const months: string[] = JSON.parse(calendar.dataset.months || '[]');
    const weekdays: string[] = JSON.parse(calendar.dataset.weekdays || '[]');
    const schedules = schedulesData.tours;
    const minLeadDays = schedulesData.minLeadDays;
    const selectedLabel = calendar.dataset.selectedLabel || 'Selected date';

    const statusEl = calendar.querySelector<HTMLElement>('.booking-calendar__status')!;
    const headerEl = calendar.querySelector<HTMLElement>('.booking-calendar__header')!;
    const titleEl = calendar.querySelector<HTMLElement>('.booking-calendar__title')!;
    const weekdaysEl = calendar.querySelector<HTMLElement>('.booking-calendar__weekdays')!;
    const gridEl = calendar.querySelector<HTMLElement>('.booking-calendar__grid')!;
    const selectedEl = calendar.querySelector<HTMLElement>('.booking-calendar__selected')!;
    const inputEl = calendar.querySelector<HTMLInputElement>('.booking-calendar__input')!;
    const prevBtn = calendar.querySelector<HTMLButtonElement>('[data-action="prev"]')!;
    const nextBtn = calendar.querySelector<HTMLButtonElement>('[data-action="next"]')!;
    const form = calendar.closest('form');

    statusEl.hidden = true;
    headerEl.hidden = false;

    // Earliest bookable date, honouring the booking cut-off in the T&Cs.
    const earliest = new Date();
    earliest.setHours(0, 0, 0, 0);
    earliest.setDate(earliest.getDate() + minLeadDays);

    let viewYear = earliest.getFullYear();
    let viewMonth = earliest.getMonth();

    weekdaysEl.innerHTML = weekdays.map((day) => `<div>${day}</div>`).join('');

      // Format in local time — toISOString() would shift the date by a day for
      // anyone east of UTC, which is every visitor booking from Japan.
      function toIso(date: Date) {
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
      }

      // The tours currently ticked, or every tour when none are ticked yet.
      function activeSlugs() {
        const checked = form
          ? Array.from(form.querySelectorAll<HTMLInputElement>('input[name="tours"]:checked'))
          : [];
        const slugs = checked.map((input) => input.dataset.tourSlug).filter(Boolean) as string[];
        return slugs.length ? slugs : Object.keys(schedules);
      }

      function isOperating(iso: string, weekday: number, slugs: string[]) {
        return slugs.some((slug) => {
          const schedule = schedules[slug];
          if (!schedule) return false;
          if (schedule.blackoutDates.includes(iso)) return false;
          return schedule.extraDates.includes(iso) || schedule.weekdays.includes(weekday);
        });
      }

      function render() {
        titleEl.textContent = `${months[viewMonth]} ${viewYear}`;

        const slugs = activeSlugs();
        const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();
        const startWeekday = new Date(viewYear, viewMonth, 1).getDay();

        const cells: string[] = [];
        for (let i = 0; i < startWeekday; i++) {
          cells.push('<div class="booking-calendar__day is-empty"></div>');
        }
        for (let day = 1; day <= daysInMonth; day++) {
          const cellDate = new Date(viewYear, viewMonth, day);
          const iso = toIso(cellDate);
          const tooSoon = cellDate < earliest;
          const unavailable = !tooSoon && !isOperating(iso, cellDate.getDay(), slugs);

          const classes = ['booking-calendar__day'];
          if (tooSoon) classes.push('is-past');
          if (unavailable) classes.push('is-unavailable');
          if (inputEl.value === iso) classes.push('is-selected');

          const selectable = !tooSoon && !unavailable;
          cells.push(
            `<div class="${classes.join(' ')}" data-date="${iso}" ${selectable ? 'role="button" tabindex="0"' : 'aria-disabled="true"'}>${day}</div>`
          );
        }

        gridEl.innerHTML = cells.join('');

        gridEl
          .querySelectorAll<HTMLElement>('.booking-calendar__day[role="button"]')
          .forEach((cell) => {
            cell.addEventListener('click', () => selectDate(cell.dataset.date!));
            cell.addEventListener('keydown', (event) => {
              if (event instanceof KeyboardEvent && (event.key === 'Enter' || event.key === ' ')) {
                event.preventDefault();
                selectDate(cell.dataset.date!);
              }
            });
          });
      }

      function selectDate(iso: string) {
        inputEl.value = iso;
        selectedEl.textContent = `${selectedLabel}: ${iso}`;
        render();
      }

      function clearDate() {
        inputEl.value = '';
        selectedEl.textContent = '';
      }

      function shiftMonth(delta: number) {
        const view = new Date(viewYear, viewMonth + delta, 1);
        viewYear = view.getFullYear();
        viewMonth = view.getMonth();
        render();
      }

      prevBtn.addEventListener('click', () => shiftMonth(-1));
      nextBtn.addEventListener('click', () => shiftMonth(1));

      // Changing the tour selection changes which days are on offer, so drop a
      // date that the newly chosen tours don't actually run on.
      form?.querySelectorAll<HTMLInputElement>('input[name="tours"]').forEach((input) => {
        input.addEventListener('change', () => {
          const iso = inputEl.value;
          if (iso) {
            const [year, month, day] = iso.split('-').map(Number);
            const selected = new Date(year, month - 1, day);
            if (!isOperating(iso, selected.getDay(), activeSlugs())) clearDate();
          }
          render();
        });
      });

    render();
  }

  document.addEventListener('DOMContentLoaded', initCalendars);
  document.addEventListener('astro:page-load', initCalendars);
</script>
